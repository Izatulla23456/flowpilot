# Caddy: автоматический HTTPS (Let's Encrypt) для FlowPilot.
# Домен берётся из переменной окружения DOMAIN (ставится в /etc/default/caddy):
#   DOMAIN=example.kz  →  site: https://example.kz
# DNS A-запись домена должна указывать на IP этого сервера ДО старта caddy.
https://{env.DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
}
